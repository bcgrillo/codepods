# Copy this file to .env and fill in values (do NOT commit .env)

# --- Example OpenAI ---
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://<resource_name>.openai.azure.com
OPENAI_DEPLOYMENT=<tu-deployment-id>
OPENAI_MODEL_NAME=<tu-modelo>
OPENAI_RESOURCE_NAME=<tu-recurso>

# --- GitHub ---
GITHUB_REPO_TOKEN=your_github_repo_token_here
# Fine-grained PAT con scope "Copilot Requests" para el CLI Copilot.
GITHUB_COPILOT_TOKEN=your_copilot_token_here
# Modelo defecto para Copilot CLI (`copilot config set default-model`).
COPILOT_MODEL=o4-mini

# --- API Auth (FastAPI) ---
DASH_USER=admin
DASH_PASSWORD=changeme
SESSION_SECRET=super-secret-phrase
SESSION_LIFETIME=86400
RELAY_TOKEN_LIFETIME=120
RELAY_COOKIE_LIFETIME=14400
# Enforce that login requires a pre-approved device fingerprint.
AUTH_REQUIRE_APPROVED_DEVICE=false
DEVICE_SECRET=another-secret
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:5173
# TCP relay port range for secure per-agent relays (open these in your firewall/NSG)
RELAY_PORT_MIN=10000
RELAY_PORT_MAX=10100

# --- HTTPS (opcional) ---
# Si defines PUBLIC_DOMAIN y existen certs en /etc/codepods/certs/<dominio>/,
# `codepods web start` habilita HTTPS automáticamente.
# Ejecuta scripts/setup-https.sh para obtener el certificado Let's Encrypt.
# PUBLIC_DOMAIN=tudominio.azure.com
# CERTBOT_EMAIL=admin@tudominio.com
